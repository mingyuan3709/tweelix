{
  "schemaVersion": 1,
  "id": "tweelix",
  "version": "${version}",
  "name": "Tweelix",
  "description": "一个面向原版生存的轻量客户端辅助模组\nA vanilla-focused lightweight client-side utility mod.",
  "authors": ["ming_yuan"],
  "contact": {
    "homepage": "https://space.bilibili.com/388406072",
    "sources": "https://github.com/mingyuan3709/tweelix",
    "issues": "https://github.com/mingyuan3709/tweelix/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/tweelix/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "ink.mingyuan.tweelix.fabric.Tweelix"
    ],
    "modmenu": [
      "ink.mingyuan.tweelix.fabric.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "tweelix.mixins.json"
  ],
  "accessWidener": "tweelix.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.21.6 <=1.21.8"
  }
